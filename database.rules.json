{
  "rules": {
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true",
        "isAdmin": {
          ".write": "false"
        }
      }
    },
    "dados": {
      "$data": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "metas": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true"
    },
    "patrimonio": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('patrimonio').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('patrimonio').val() === true)"
    },
    "estoque": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('estoque').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('estoque').val() === true)"
    },
    "movimentacoes_estoque": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('estoque').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('estoque').val() === true)"
    },
    "fornecedores": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('fornecedores').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('fornecedores').val() === true)"
    },
    "pacientes_cadastro": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('recepcao').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('recepcao').val() === true)"
    },
    "campanhas": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('marketing').val() === true)",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('isAdmin').val() === true || root.child('usuarios').child(auth.uid).child('permissoes').child('marketing').val() === true)"
    },
    "auditoria": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true",
      ".write": "auth != null"
    },
    "diretorio": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "conversas": {
      "$conversaId": {
        ".read": "auth != null && $conversaId.contains(auth.uid) && (!data.exists() || data.child('participantes').child(auth.uid).exists())",
        ".write": "auth != null && $conversaId.contains(auth.uid) && (!data.exists() || data.child('participantes').child(auth.uid).exists())"
      }
    },
    "mensagens": {
      "$conversaId": {
        ".read": "auth != null && root.child('conversas').child($conversaId).child('participantes').child(auth.uid).exists()",
        "$mensagemId": {
          ".write": "auth != null && root.child('conversas').child($conversaId).child('participantes').child(auth.uid).exists() && (newData.exists() ? newData.child('remetente').val() === auth.uid : data.child('remetente').val() === auth.uid)",
          ".validate": "newData.hasChildren(['remetente', 'texto', 'criado_em'])"
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversaId": {
          ".write": "auth != null && root.child('conversas').child($conversaId).child('participantes').child(auth.uid).exists()"
        }
      }
    }
  }
}
